# 1. Configurações fundamentais (Isso evita baixar o arquivo)
Options -Indexes -MultiViews
DirectoryIndex index.html

# 2. Ativar redirecionamentos
RewriteEngine On
RewriteBase /

# --- REGRA 1: CORREÇÃO DE ERRO DE DIGITAÇÃO (LH -> LL) ---
# Se digitarem "parrilha" (de qualquer jeito), manda para a pasta certa
RewriteRule ^parrilha316/?$ /parrilla316/ [R=301,NC,L]

# --- REGRA 2: CLAUDIA CAKES (Maiúsculo -> Minúsculo) ---
# O [NC] aceita ClaudiaCakes, CLAUDIACAKES, etc.
# E joga para o link que sabemos que funciona (/claudiacakes/)
RewriteRule ^claudiacakes/?$ /claudiacakes/ [R=301,NC,L]

# --- REGRA 3: PARRILLA 316 (Maiúsculo -> Minúsculo) ---
RewriteRule ^parrilla316/?$ /parrilla316/ [R=301,NC,L]
