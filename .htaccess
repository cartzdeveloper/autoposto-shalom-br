Options +FollowSymLinks
RewriteEngine On

# -----------------------------------------------------------
# REGRA 1: CLAUDIA CAKES
# -----------------------------------------------------------
# Se digitarem ClaudiaCakes, ClAuDiA..., etc -> vai para "claudiacakes"
RewriteRule ^claudiacakes/?$ /claudiacakes/ [R=301,NC,L]


# -----------------------------------------------------------
# REGRA 2: PARRILLA 316 (Com LL - O correto)
# -----------------------------------------------------------
# Se digitarem Parrilla316, parrilla316, etc -> vai para "parrilla316"
RewriteRule ^parrilla316/?$ /parrilla316/ [R=301,NC,L]


# -----------------------------------------------------------
# REGRA 3: CORREÇÃO DE ERRO (LH para LL)
# -----------------------------------------------------------
# Se alguém digitar "Parrilha" (com LH), corrigimos para a pasta certa
RewriteRule ^parrilha316/?$ /parrilla316/ [R=301,NC,L]
